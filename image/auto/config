#!/bin/sh
# live-build: configuração do OSX-REIMS-OS (Debian 13 / trixie, amd64, UEFI).
# Regenera a config a cada build. Ver image/README.md.
set -e

# --mode debian + mirrors Debian explícitos: sem isso, num host Ubuntu (ex.: o
# runner do GitHub Actions) o live-build entra em "modo ubuntu".
DEB_MIRROR="http://deb.debian.org/debian/"

# --debian-installer none: o instalador é o nosso (reims-installer), que roda no
#   próprio sistema live e copia o squashfs para o disco, sem internet.
# --bootloaders grub-efi: só UEFI (BIOS legado não é suportado).
# --security false: o live-build empacotado usa o suite antigo 'trixie/updates';
#   o sistema instalado recebe trixie-security por config/archives.
# --firmware-*: só o firmware de rede da lista de pacotes; o de GPU é escolhido
#   no first setup, para a máquina.
lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--security false \
	--apt-recommends false \
	--firmware-chroot false \
	--firmware-binary false \
	--mirror-bootstrap "${DEB_MIRROR}" \
	--mirror-chroot "${DEB_MIRROR}" \
	--mirror-binary "${DEB_MIRROR}" \
	--parent-mirror-bootstrap "${DEB_MIRROR}" \
	--parent-mirror-chroot "${DEB_MIRROR}" \
	--parent-mirror-binary "${DEB_MIRROR}" \
	--debian-installer none \
	--bootloaders grub-efi \
	--binary-images iso-hybrid \
	--checksums sha256 \
	--bootappend-live "boot=live components quiet splash noeject" \
	--iso-application "OSX-REIMS-OS" \
	--iso-publisher "OSX-REIMS-OS" \
	--iso-volume "OSX-REIMS-OS" \
	--memtest none \
	"${@}"
