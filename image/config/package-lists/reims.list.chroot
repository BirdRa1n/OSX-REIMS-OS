linux-image-amd64
firmware-linux
firmware-misc-nonfree

# virtualização
qemu-system-x86
qemu-utils
ovmf

# Vulkan / Mesa (ANV Intel + RADV AMD)
mesa-vulkan-drivers
vulkan-tools
libvulkan1

# (manuseio da OpenCore.qcow2 usa qemu-nbd, já incluso no qemu-utils acima)

# rede/utilidades
git
curl
ca-certificates
sudo
pciutils
